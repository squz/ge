# Generated by `make ge/ios-init` (tools/init-ios.sh) — hand-editable.
#
# Generates ios/__APP_BIN_NAME__.xcodeproj for the consuming app. Invoke
# from the project root via the make rules in Module.mk
# (`make ge/ios`, `make ge/ios-release`, `make ge/ios-device-release`)
# or directly:
#
#   bundle exec ruby ios/project.rb                  # device-only (release)
#   bundle exec ruby ios/project.rb --simulator      # adds sim slice

require_relative '__GE_REL__/tools/ios-build/build_project'

# Resolve ge root explicitly so both in-tree samples and external
# submodule consumers (e.g. multimaze2 with ge/ as a submodule) work
# without special-casing the path inside ProjectBuilder.
GE_ROOT = File.expand_path('__GE_REL__', __dir__)

simulator = ARGV.include?('--simulator')

GE::IOS::ProjectBuilder.new(
  app_name:          '__APP_BIN_NAME__',
  bundle_id:         '__BUNDLE_ID__',
  marketing_version: '0.1.0',
  build_number:      '1',
  display_name:      '__APP_NAME__',
  team_id:           '__DEVELOPMENT_TEAM__'.empty? ? ENV.fetch('APPLE_TEAM_ID') : '__DEVELOPMENT_TEAM__',
  ge_root:           GE_ROOT,
  game_sources:      Dir.glob('src/*.cpp') + Dir.glob('src/*.mm'),
  resources: [
    # Add files / directories relative to the project root. Directories
    # land at their full project-relative path inside the .app bundle
    # (preserved by build_project.rb's per-parent Copy Files phases,
    # 🎯T72). Example:
    #   'data',
    #   'shaders/bgfx/metal',
  ],
  simulator: simulator,
).generate
