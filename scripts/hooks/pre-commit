#!/usr/bin/env bash
# Pre-commit hook for ge.
# Activated by: git config core.hooksPath scripts/hooks
#
# Phase 1 LFS exit:
# 1) Reject staging prebuilt/vendor binary cook outputs (do not commit archives).
# 1b) Refuse a commit that leaves an unlanded bullseye.yaml filing behind (🎯T200).
# 2) When relevant paths change, run tools/verify-prebuilds.py tip-tree gate.
#
# Bypass for an unrelated change:  git commit --no-verify
#
# Copyright 2026 Marcelo Cantos
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)

# ── 1. Reject staged binary cook outputs ──────────────────────────────────
bin_bad=()
for path in "${staged[@]}"; do
  base="${path##*/}"
  if [[ "$path" == prebuilt/* && "$base" == *.a ]]; then
    bin_bad+=("$path"); continue
  fi
  if [[ "$path" == vendor/* && "$base" == *.a ]]; then
    bin_bad+=("$path"); continue
  fi
  if [[ "$base" == libge.a ]]; then
    bin_bad+=("$path"); continue
  fi
  if [[ "$path" == prebuilt/* || "$path" == vendor/* ]]; then
    case "$base" in
      *.so|*.dylib|*.o|*.lib|*.dll|*.exe) bin_bad+=("$path"); continue ;;
    esac
  fi
  if [[ "$base" == *.jar && "$path" != *gradle-wrapper.jar ]]; then
    bin_bad+=("$path"); continue
  fi
  if [[ "$path" == bin/*/shaderc ]]; then
    bin_bad+=("$path"); continue
  fi
done

if ((${#bin_bad[@]} > 0)); then
  {
    echo "error: do not commit prebuilt/binary cook outputs (Phase 1 LFS exit):"
    for p in "${bin_bad[@]}"; do
      echo "  $p"
    done
    echo ""
    echo "Cook locally with \`make prebuild\` / ensure-prebuilt; leave archives untracked."
    echo "See docs/vendor-prebuilds.md."
  } >&2
  exit 1
fi

# ── 1b. Intent ledger: a filing must not be left behind (🎯T200) ──────────
# This repo's lifecycle rule is that the ledger rides the commit that changes
# it. What this catches is committing other work while a freshly filed target
# sits unstaged in the working copy: it then exists in no commit at all, and
# the next agent's `bullseye` mints the same ids against a copy that cannot
# see it. Committing the ledger on a feature branch is fine and is NOT blocked
# — it reaches master when the branch does.
#
# Delegates to the same check `make ledger-check` runs, rather than restating
# the rule: a second copy of this logic would drift, and the copy that drifted
# first would be the one tolerating a stale-but-landed ledger, turning every
# long-lived checkout unable to commit the moment master moves.
#
# Skipped when the ledger is staged (it is riding this commit, as intended),
# and in any checkout without the script — e.g. a consumer's ge submodule.
if [[ -x "$REPO_ROOT/tools/check-ledger-parity.sh" ]] \
   && ! git diff --cached --name-only | grep -qx 'bullseye\.yaml'; then
  if ! "$REPO_ROOT/tools/check-ledger-parity.sh" >/dev/null 2>&1; then
    "$REPO_ROOT/tools/check-ledger-parity.sh" >&2 || true
    {
      echo "This commit does not include bullseye.yaml, so that filing would be"
      echo "left behind in the working copy — invisible to every other checkout."
      echo ""
      echo "  Include it:  git add bullseye.yaml"
      echo "  Or land it:  make ledger-land"
    } >&2
    exit 1
  fi
fi

# ── 2. Tip-tree gate when attributes/ignore/verify paths touch ────────────
RELEVANT_PATTERNS=(
  '^prebuilt/'
  '^\.gitattributes$'
  '^\.gitignore$'
  '^tools/verify-prebuilds\.py'
  '^scripts/hooks/pre-commit$'
  '^\.github/workflows/verify-prebuilds\.yml$'
)

relevant=false
for path in "${staged[@]}"; do
  for pat in "${RELEVANT_PATTERNS[@]}"; do
    if [[ "$path" =~ $pat ]]; then
      relevant=true
      break 2
    fi
  done
done

if ! $relevant; then
  exit 0
fi

exec python3 "$REPO_ROOT/tools/verify-prebuilds.py"
