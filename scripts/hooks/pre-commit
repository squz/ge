#!/usr/bin/env bash
# Pre-commit hook for ge.
# Activated by: git config core.hooksPath scripts/hooks
#
# 1) Always: reject staged binary paths that have filter=lfs but whose
#    index blob is not an LFS pointer (would bloat the git object store).
# 2) When prebuilt inputs change: run tools/verify-prebuilds.py.
#
# Bypass for an unrelated change:  git commit --no-verify
#
# Copyright 2026 Marcelo Cantos
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── 1. Git LFS: staged files with filter=lfs must be pointers ─────────────
# Covers new prebuilt/**/*.a, vendor .a, jars, etc. once .gitattributes
# routes them through LFS. A missing git-lfs clean filter is the usual
# failure mode (full archive committed as a plain blob).
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)

lfs_bad=()
for path in "${staged[@]}"; do
  # Renames: check the destination path only.
  filter="$(git check-attr filter -- "$path" | awk -F': ' '{print $NF}')"
  if [[ "$filter" != "lfs" ]]; then
    continue
  fi
  # Index blob must start with the LFS pointer header (small text file).
  if ! git cat-file -p ":$path" 2>/dev/null | head -c 100 | grep -q '^version https://git-lfs.github.com/spec/v1'; then
    lfs_bad+=("$path")
  fi
done

if ((${#lfs_bad[@]} > 0)); then
  {
    echo "error: staged file(s) are LFS-tracked but not LFS pointers:"
    for p in "${lfs_bad[@]}"; do
      size="$(git cat-file -s ":$p" 2>/dev/null || echo '?')"
      echo "  $p  (index blob ~${size} bytes)"
    done
    echo ""
    echo "Fix: install git-lfs, then re-stage:"
    echo "  git lfs install"
    echo "  git lfs track   # confirm patterns in .gitattributes"
    echo "  git add --renormalize -- ${lfs_bad[*]}"
    echo ""
    echo "Never commit large .a/.so/.jar as plain git blobs."
  } >&2
  exit 1
fi

# ── 2. Prebuilt freshness (only when relevant paths are staged) ───────────
RELEVANT_PATTERNS=(
  '^src/'
  '^include/'
  '^vendor/src/'
  '^vendor/include/'
  '^headers/'
  '^tools/player_orientation_ios\.mm'
  '^tools/prebuild\.sh'
  '^tools/lift-headers\.sh'
  '^tools/write-manifest\.py'
  '^tools/verify-prebuilds\.py'
  '^\.gitmodules$'
  '^prebuilt/'
)

# Submodule SHA bumps (gitlink) under vendor/github.com/.
for path in "${staged[@]}"; do
  if [[ "$path" == vendor/github.com/* ]] && \
     [[ "$(git ls-files --stage -- "$path" 2>/dev/null | awk '{print $1}')" == "160000" ]]; then
    RELEVANT_PATTERNS+=('^'"$(printf '%s' "$path" | sed 's/[.\\\\\\/]/\\\\&/g')"'$')
  fi
done

relevant=false
for path in "${staged[@]}"; do
  for pat in "${RELEVANT_PATTERNS[@]}"; do
    if [[ "$path" =~ $pat ]]; then
      relevant=true
      break 2
    fi
  done
done

if ! $relevant; then
  exit 0
fi

exec python3 "$REPO_ROOT/tools/verify-prebuilds.py"
